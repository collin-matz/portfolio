---
import '../styles/global.css';
const { id, title, desc } = Astro.props;
---

<section id={id}>
    <h1>{title}</h1>
    <p>{desc}</p>
    <slot />
</section>

<style>
    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        row-gap: 2em;
        scroll-margin-top: 6em;
    }

    h1 {
        font-weight: 400;
        margin: -0.5em;
    }

    p {
        color: gray;
        font-weight: bolder;
        margin: 0;
        max-width: 80%;
        text-align: center;
    }
</style>

