---
const { title, subtitle, description, dates, location, bullets, link, tags } = Astro.props;
const Title = link ? 'a' : 'span';
---

<div class="card">
    {(title || dates) && (
        <div class="row">
            <Title href={link} id="title">
                <h5>{title}</h5>
            </Title>
            {dates && <p>{dates}</p>}
        </div>
    )}
    {(subtitle || location) && (
        <div class="row">
            <h5 id="subtitle">{subtitle}</h5>
            {location && <p>{location}</p>}
        </div>
    )}
    {description && <p id="description">{description}</p>}
    {bullets && (
        <ul class="bullets-list">
            {bullets.map((bullet: string, i: number) => (
                <li class="bullet" key={i}>{bullet}</li>
            ))}
        </ul>
    )}
    {tags && tags.length > 0 && (
        <div class="tag-list">
            {tags.map((tag: string) => (
                <p class="tag">{tag}</p>
            ))}
        </div>
    )}
</div> 


<style>
    .card {
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        border: 1px solid lightgray;
        border-radius: 1rem;
        padding: 1rem;
        width: 75%;
    }

    .row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    .tag-list {
        display: flex;
        column-gap: 1rem;
        row-gap: 1rem;
        margin-top: 0.6rem;
        flex-wrap: wrap;
    }

    .tag {
        text-align: center;
        justify-content: center;
        padding: 0.3em;
        border: 1px solid lightgray;
        border-radius: 0.5em;
        font-size: small;
        font-weight: bolder;
        color: black;
    }

    #description {
        margin-top: 0.5rem;
    }

    h5 {
        margin: 0;
        font-weight: 600;
    }

    p {
        margin: 0;
    }

    ul {
        padding-left: 1.25rem;
        margin: 0.5rem 0 0;
    }

    a {
        text-decoration: underline;
    }
</style>