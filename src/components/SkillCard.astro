---
import '../styles/global.css';
const { title, tags } = Astro.props;
---

<div class="container">
    <h5>{title}</h5>
    <div class="tag-list">
        {tags.map((tag: string) => (
            <p class="tag">{tag}</p>
        ))}
    </div>
</div>

<style>
    .container {
        display: flex;
        flex-direction: column;
        border: 1px solid lightgray;
        border-radius: 1em;
        padding: 1em;
        width: 100%;
    }

    .tag-list {
        display: flex;
        flex-direction: row;
        column-gap: 1em;
        row-gap: 1em;
        margin-top: 1em;
        flex-wrap: wrap;
    }

    .tag {
        text-align: center;
        justify-content: center;

        padding: 0.3em;
        border: 1px solid lightgray;
        border-radius: 0.5em;
        font-size: small;
        font-weight: bolder;
        color: black;
    }

    h5 {
        margin: 0;
        font-weight: 600;
    }

    p {
        margin: 0;
        color: gray;
    }
</style>