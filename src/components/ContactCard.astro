---
import '../styles/global.css';
const { title, subtitle, link } = Astro.props;
---

<a href={link} class="container">
    <h5>{title}</h5>
    {subtitle && <p>{subtitle}</p>}
</a>

<style>
    h5 {
        margin: 0;
        font-weight: 600;
    }

    p {
        margin: 0;
    }

    .container {
        display: flex;
        flex-direction: column;
        border: 1px solid lightgray;
        border-radius: 1em;
        padding: 1em;
        width: 45%;
        min-width: fit-content;
    }
</style>